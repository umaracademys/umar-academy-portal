{
  "name": "umar-academy-portal",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "create-developer": "node backend/createDeveloper.js",
    "create-developer:prod": "node backend/createDeveloperProduction.js",
    "check-developer": "node backend/checkDeveloperAccount.js",
    "dev": "vite",
    "build": "tsc --noEmit --incremental && vite build",
    "build:fast": "vite build",
    "build:mushaf": "pnpm --filter @umar-academy/mushaf build",
    "build:all": "pnpm -r build",
    "build:render": "corepack enable && corepack prepare pnpm@latest --activate && pnpm install --frozen-lockfile --no-optional && pnpm --filter @umar-academy/mushaf build && pnpm run build:fast",
    "preview": "vite preview",
    "start": "node frontend-server.js",
    "seed": "tsx src/scripts/seedData.ts",
    "test-db": "tsx src/scripts/testConnection.ts",
    "setup-mistakes-db": "tsx src/scripts/setupMistakesDb.ts",
    "test:production": "node backend/production-test.js",
    "test:production:remote": "API_BASE_URL=https://umar-academy-backend.onrender.com/api node backend/production-test.js"
  },
  "dependencies": {
    "@umar-academy/mushaf": "workspace:*",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.22",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.5.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.19.3",
    "nodemailer": "^7.0.12",
    "pdfjs-dist": "^5.4.449",
    "postcss": "^8.4.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "^10.2.0",
    "react-router-dom": "^6.30.1",
    "sql.js": "^1.13.0",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^3.4.18",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.9",
    "esbuild": "^0.27.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  }
}
