{
  "name": "umar-academy-portal",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:mushaf": "pnpm --filter @umar-academy/mushaf build",
    "build:all": "pnpm -r build",
    "build:render": "corepack enable && corepack prepare pnpm@latest --activate && pnpm install && pnpm --filter @umar-academy/mushaf build && pnpm run build",
    "preview": "vite preview",
    "start": "node frontend-server.js",
    "seed": "tsx src/scripts/seedData.ts",
    "test-db": "tsx src/scripts/testConnection.ts",
    "setup-mistakes-db": "tsx src/scripts/setupMistakesDb.ts",
    "postinstall": "pnpm --filter @umar-academy/mushaf build"
  },
  "dependencies": {
    "@umar-academy/mushaf": "workspace:*",
    "bcryptjs": "^3.0.2",
    "express": "^4.21.2",
    "mongoose": "^8.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "sql.js": "^1.13.0",
    "sqlite3": "^5.1.7",
    "vite": "^5.4.21",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^3.4.18",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.22"
  },
  "devDependencies": {
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.9",
    "esbuild": "^0.27.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  }
}
