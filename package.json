{
  "name": "umar-academy-portal",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:mushaf": "pnpm --filter @umar-academy/mushaf build",
    "build:all": "pnpm -r build",
    "build:render": "corepack enable && corepack prepare pnpm@latest --activate && pnpm install && pnpm --filter @umar-academy/mushaf build && pnpm run build",
    "preview": "vite preview",
    "start": "node frontend-server.js",
    "seed": "tsx src/scripts/seedData.ts",
    "test-db": "tsx src/scripts/testConnection.ts",
    "setup-mistakes-db": "tsx src/scripts/setupMistakesDb.ts"
  },
  "dependencies": {
    "@umar-academy/mushaf": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.2",
    "express": "^4.18.2",
    "mongoose": "^8.19.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "sql.js": "^1.13.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/sql.js": "^1.4.9",
    "@types/sqlite3": "^3.1.11",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
